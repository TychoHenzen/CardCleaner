[node name="CardEffectComparison" type="Node3D" node_paths=PackedStringArray("CardParent", "LabelParent", "BatchParent", "Camera", "Readout")]
script = ExtResource("Comparison")
CardParent = NodePath("Cards")
LabelParent = NodePath("Labels")
BatchParent = NodePath("Batch")
Camera = NodePath("Camera3D")
Readout = NodePath("Hud/Readout")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_comparison")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.81923, -0.45593, 0.34783, 0, 0.60655, 0.79505, -0.57346, -0.65133, 0.4969, 0, 4, 0)
light_energy = 1.2

[node name="Camera3D" type="Camera3D" parent="."]
