<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Unit tier: suites that run in the plain .NET test host, with no Godot process. A suite belongs here only when
      neither it nor the code it calls needs the engine; anything that does stays in Tests/ and runs inside Godot
      (Scripts/ci/Run-GdUnit.ps1). Run with: dotnet test UnitTests
      The folder has a .gdignore, so Godot neither imports these files nor writes .uid sidecars for them, and
      CardCleaner.csproj leaves the folder out of the game assembly.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>CardCleaner.Tests</RootNamespace>
        <AnalysisLevel>8.0-recommended</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <!-- A build reports IDE0005 (unused using) only with code-style rules on and XML comments parsed. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
        <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
        <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FsCheck" Version="3.4.0" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\CardCleaner.csproj" />
    </ItemGroup>
</Project>
