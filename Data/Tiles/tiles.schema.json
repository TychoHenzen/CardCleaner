{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tile Registry",
  "description": "Data-driven tile definitions for CardCleaner",
  "type": "object",
  "required": ["version", "tileset", "tiles"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "tileset": {
      "type": "string",
      "pattern": "^res://.*\\.tres$",
      "description": "Path to the TileSet resource (e.g., res://Assets/Terrain/TileSets/ByPack/FantasyDreamland.tres)"
    },
    "tilesetConfig": {
      "$ref": "#/definitions/tilesetConfig",
      "description": "Optional tileset-level configuration (defaults to 16x16 tiles with no offset)"
    },
    "autoTileFormats": {
      "type": "array",
      "items": { "$ref": "#/definitions/autoTileFormat" },
      "description": "Custom auto-tile format definitions. Built-in formats (corner16, edge16, blob47) are always available."
    },
    "biomes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/biomeDefinition" },
      "description": "Biome definitions with tile pools and signatures"
    },
    "tiles": {
      "type": "array",
      "items": { "$ref": "#/definitions/tile" }
    }
  },
  "definitions": {
    "tilesetConfig": {
      "type": "object",
      "description": "Tileset-level spatial configuration",
      "properties": {
        "baseTileSize": {
          "$ref": "#/definitions/vector2i",
          "description": "Base tile size in pixels (default 16x16). Common values: 16x16, 24x24, 32x32."
        },
        "gridOffset": {
          "$ref": "#/definitions/vector2",
          "description": "Grid offset for half-tile shifted tilesets (default 0,0). Use 0.5,0.5 for half-tile shift."
        }
      }
    },
    "autoTileFormat": {
      "type": "object",
      "required": ["name", "bitmaskType", "variants"],
      "description": "Custom auto-tile format definition",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique format name (snake_case). Must not conflict with built-in formats."
        },
        "bitmaskType": {
          "type": "string",
          "enum": ["corner4", "edge4", "full8"],
          "description": "Neighbor computation algorithm: corner4 (diagonals), edge4 (cardinals), full8 (all 8)"
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/formatVariant" },
          "description": "Variant definitions for allowed bitmask values. Omitted bitmasks are forbidden."
        }
      }
    },
    "formatVariant": {
      "type": "object",
      "required": ["bitmask", "atlasCoords"],
      "description": "A single variant in a custom auto-tile format",
      "properties": {
        "bitmask": {
          "type": "integer",
          "minimum": 0,
          "description": "The bitmask value this variant represents (0-15 for 4-bit, 0-255 for 8-bit)"
        },
        "atlasCoords": {
          "$ref": "#/definitions/vector2i",
          "description": "Position of this variant in the atlas (tile coordinates)"
        },
        "size": {
          "$ref": "#/definitions/vector2i",
          "description": "Cells occupied by this variant (default 1x1). For tall variants like 3-tile walls: {x:1, y:3}"
        },
        "offset": {
          "$ref": "#/definitions/vector2i",
          "description": "Anchor offset from logical cell (default 0,0). For tall variants: {x:0, y:-2}"
        },
        "atlasRegionSize": {
          "$ref": "#/definitions/vector2i",
          "description": "Override source region size if non-standard (default uses tileset baseTileSize)"
        }
      }
    },
    "tile": {
      "type": "object",
      "required": ["id", "name", "passability", "atlasCoords"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique tile identifier (snake_case)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "passability": {
          "type": "string",
          "enum": ["passable", "solid", "partially_passable"],
          "description": "Whether units can move through this tile"
        },
        "atlasCoords": {
          "$ref": "#/definitions/vector2i",
          "description": "Position in tileset atlas"
        },
        "sourceId": {
          "type": "integer",
          "default": 4,
          "description": "TileSet source ID in Godot"
        },
        "layer": {
          "type": "string",
          "enum": ["terrain", "decoration", "structure", "effects"],
          "default": "terrain",
          "description": "Rendering layer"
        },
        "elevation": {
          "type": "number",
          "default": 0,
          "description": "Height for visibility/combat calculations"
        },
        "isTransparent": {
          "type": "boolean",
          "description": "Whether units can see through this tile. Defaults based on passability."
        },
        "biomes": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["plains", "forest", "desert", "tundra", "swamp", "mountains", "water", "cave", "volcanic", "magical"]
              }
            }
          ],
          "description": "Biomes where this tile can spawn. Null means universal."
        },
        "size": {
          "$ref": "#/definitions/vector2i",
          "description": "Tile size for multi-tile support (default 1x1)"
        },
        "autoTileVariants": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/vector2i" },
              { "type": "null" }
            ]
          },
          "description": "Auto-tile variant atlas coordinates indexed by bitmask"
        },
        "decorationDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of decoration tile appearing (0-1)"
        },
        "autoTileFormat": {
          "type": "string",
          "default": "corner16",
          "description": "Auto-tile format name (built-in: corner16, edge16, blob47; or custom format name)"
        },
        "variations": {
          "type": "array",
          "items": { "$ref": "#/definitions/vector2i" },
          "description": "Visual variations for this tile (different atlas coordinates)"
        },
        "variationMode": {
          "type": "string",
          "enum": ["perinstance", "pergeneration"],
          "default": "perinstance",
          "description": "How variations are selected (perinstance=random per tile, pergeneration=one per map)"
        },
        "animation": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "array",
              "items": { "$ref": "#/definitions/vector2i" },
              "description": "Animation frame atlas coordinates"
            },
            "frameDuration": {
              "type": "number",
              "default": 0.2,
              "description": "Duration of each frame in seconds"
            }
          },
          "description": "Animation configuration for animated tiles"
        },
        "tileMode": {
          "type": "string",
          "enum": ["plain", "pertile_variations", "permap_variations", "autotile", "permap_variation_autotile", "animated"],
          "default": "plain",
          "description": "Rendering mode determining active features"
        },
        "dominance": {
          "type": "integer",
          "description": "Visual dominance for terrain transitions (higher renders on top)"
        },
        "sourceScale": {
          "type": "number",
          "default": 1.0,
          "description": "Source scale for tiles from differently-sized textures (0.5=32px, 1.0=16px, 2.0=8px)"
        },
        "innerTerrain": {
          "type": "string",
          "description": "For auto-tiles: terrain whose border is shown. Null uses dominance-based resolution."
        },
        "outerTerrain": {
          "type": "string",
          "description": "For auto-tiles: background terrain. '*' = compositable (transparent, composite onto any base). Specific ID = fixed transition."
        },
        "description": {
          "type": "string",
          "description": "Visual appearance description for artists and AI image generators. Should include color, texture, and notable visual features."
        }
      }
    },
    "vector2i": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "vector2": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "biomeDefinition": {
      "type": "object",
      "required": ["displayName", "signature", "blockedPercentage", "passableTiles", "blockedTiles"],
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Human-readable biome name"
        },
        "signature": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 8,
          "maxItems": 8,
          "description": "8D card signature [Solidum, Febris, Ordinem, Lumines, Varias, Inertiae, Subsidium, Spatium]"
        },
        "blockedPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Percentage of tiles that should be blocked (0-1)"
        },
        "passableTiles": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Map of tile IDs to weights for passable tiles"
        },
        "blockedTiles": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Map of tile IDs to weights for blocked tiles"
        }
      }
    }
  }
}
