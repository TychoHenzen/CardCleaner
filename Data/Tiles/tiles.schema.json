{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tile Registry",
  "description": "Data-driven tile definitions for CardCleaner",
  "type": "object",
  "required": ["version", "tileset", "tiles"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "tileset": {
      "type": "string",
      "pattern": "^res://.*\\.tres$",
      "description": "Path to the TileSet resource (e.g., res://Assets/Terrain/TileSets/ByPack/FantasyDreamland.tres)"
    },
    "tiles": {
      "type": "array",
      "items": { "$ref": "#/definitions/tile" }
    },
    "blobGeneration": {
      "$ref": "#/definitions/blobGenerationConfig",
      "description": "Configuration for coherent terrain region generation"
    }
  },
  "definitions": {
    "tile": {
      "type": "object",
      "required": ["id", "name", "passability", "atlasCoords"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique tile identifier (snake_case)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "passability": {
          "type": "string",
          "enum": ["passable", "solid", "partially_passable"],
          "description": "Whether units can move through this tile"
        },
        "atlasCoords": {
          "$ref": "#/definitions/vector2i",
          "description": "Position in tileset atlas"
        },
        "sourceId": {
          "type": "integer",
          "default": 4,
          "description": "TileSet source ID in Godot"
        },
        "layer": {
          "type": "string",
          "enum": ["terrain", "decoration", "structure", "effects"],
          "default": "terrain",
          "description": "Rendering layer"
        },
        "elevation": {
          "type": "number",
          "default": 0,
          "description": "Height for visibility/combat calculations"
        },
        "isTransparent": {
          "type": "boolean",
          "description": "Whether units can see through this tile. Defaults based on passability."
        },
        "biomes": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["plains", "forest", "desert", "tundra", "swamp", "mountains"]
              }
            }
          ],
          "description": "Biomes where this tile can spawn. Null means universal."
        },
        "size": {
          "$ref": "#/definitions/vector2i",
          "description": "Tile size for multi-tile support (default 1x1)"
        },
        "autoTileVariants": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/vector2i" },
              { "type": "null" }
            ]
          },
          "description": "Auto-tile variant atlas coordinates indexed by bitmask"
        },
        "decorationDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of decoration tile appearing (0-1)"
        },
        "blobSettings": {
          "$ref": "#/definitions/blobGenerationConfig",
          "description": "Per-tile blob generation settings (overrides global)"
        }
      }
    },
    "vector2i": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "blobGenerationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to use noise-based clustering for terrain tiles"
        },
        "noiseScale": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.01,
          "maximum": 1.0,
          "description": "Scale of the noise pattern (smaller = larger blobs)"
        },
        "clusterStrength": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly tiles cluster together (0 = random, 1 = very clustered)"
        },
        "minBlobSize": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Minimum blob size in tiles"
        },
        "maxBlobSize": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "description": "Maximum blob size in tiles"
        }
      }
    }
  }
}
