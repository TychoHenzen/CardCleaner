{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tile Registry",
  "description": "Data-driven tile definitions for CardCleaner",
  "type": "object",
  "required": ["version", "tileset", "tiles"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "tileset": {
      "type": "string",
      "pattern": "^res://.*\\.tres$",
      "description": "Path to the TileSet resource (e.g., res://Assets/Terrain/TileSets/ByPack/FantasyDreamland.tres)"
    },
    "tiles": {
      "type": "array",
      "items": { "$ref": "#/definitions/tile" }
    },
    "terrainGroups": {
      "type": "object",
      "description": "Groups of tiles that share transition behavior",
      "additionalProperties": { "$ref": "#/definitions/terrainGroup" }
    },
    "transitionRules": {
      "type": "array",
      "description": "Rules for edge transitions between terrain groups",
      "items": { "$ref": "#/definitions/transitionRule" }
    },
    "blobGeneration": {
      "$ref": "#/definitions/blobGenerationConfig",
      "description": "Configuration for coherent terrain region generation"
    }
  },
  "definitions": {
    "tile": {
      "type": "object",
      "required": ["id", "name", "passability", "atlasCoords"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique tile identifier (snake_case)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        "passability": {
          "type": "string",
          "enum": ["passable", "solid", "partially_passable"],
          "description": "Whether units can move through this tile"
        },
        "atlasCoords": {
          "$ref": "#/definitions/vector2i",
          "description": "Position in tileset atlas"
        },
        "sourceId": {
          "type": "integer",
          "default": 4,
          "description": "TileSet source ID in Godot"
        },
        "layer": {
          "type": "string",
          "enum": ["terrain", "decoration", "structure", "effects"],
          "default": "terrain",
          "description": "Rendering layer"
        },
        "elevation": {
          "type": "number",
          "default": 0,
          "description": "Height for visibility/combat calculations"
        },
        "isTransparent": {
          "type": "boolean",
          "description": "Whether units can see through this tile. Defaults based on passability."
        },
        "biomes": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["plains", "forest", "desert", "tundra", "swamp", "mountains"]
              }
            }
          ],
          "description": "Biomes where this tile can spawn. Null means universal."
        }
      }
    },
    "vector2i": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "terrainGroup": {
      "type": "object",
      "required": ["name", "members"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for the terrain group"
        },
        "priority": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "maximum": 255,
          "description": "Higher priority groups render edges on top of lower priority groups"
        },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Tile IDs that belong to this group"
        }
      }
    },
    "transitionRule": {
      "type": "object",
      "required": ["fromGroup", "toGroup", "edgeTiles"],
      "properties": {
        "fromGroup": {
          "type": "string",
          "description": "Terrain group that has the edges (higher priority, renders on top)"
        },
        "toGroup": {
          "type": "string",
          "description": "Terrain group being transitioned to (lower priority, underneath)"
        },
        "edgeTiles": {
          "type": "object",
          "description": "Maps 4-bit bitmask (0-15) to transition tile ID. Bits: N=1, E=2, S=4, W=8",
          "patternProperties": {
            "^([0-9]|1[0-5])$": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "blobGenerationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to use noise-based clustering for terrain tiles"
        },
        "noiseScale": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.01,
          "maximum": 1.0,
          "description": "Scale of the noise pattern (smaller = larger blobs)"
        },
        "clusterStrength": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly tiles cluster together (0 = random, 1 = very clustered)"
        },
        "minBlobSize": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Minimum blob size in tiles"
        },
        "maxBlobSize": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "description": "Maximum blob size in tiles"
        }
      }
    }
  }
}
