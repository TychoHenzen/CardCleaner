[gd_resource type="Resource" script_class="StaffCatalog" format=3]

[ext_resource type="Script" path="res://Scripts/Features/Shop/Models/StaffCatalog.cs" id="1_catalog"]
[ext_resource type="Script" path="res://Scripts/Features/Shop/Models/StaffRoleData.cs" id="2_roledata"]

[sub_resource type="Resource" id="Resource_cashier"]
script = ExtResource("2_roledata")
Id = "cashier"
DisplayName = "Cashier"
UnlockId = "staff_cashier"
HireFee = 200
DailyWage = 40
SecondsPerScan = 1.5
SecondsPerPayment = 2.0
TakeOverDelay = 3.0

[sub_resource type="Resource" id="Resource_restocker"]
script = ExtResource("2_roledata")
Id = "restocker"
DisplayName = "Restocker"
UnlockId = "staff_restocker"
HireFee = 300
DailyWage = 30
SecondsPerScan = 0.0
SecondsPerPayment = 0.0
TakeOverDelay = 0.0

[resource]
script = ExtResource("1_catalog")
Roles = [SubResource("Resource_cashier"), SubResource("Resource_restocker")]
