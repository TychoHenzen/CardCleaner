 const TRIVIAL_LINE = /^[\s{}()[\];,]*$/;
 const COMMENT_LINE = /^\s*(\/\/|#|\*|\/\*)/;
 const IMPORT_LINE = /^\s*(import|export)\b[^;]*\bfrom\b/;
+// C# using directives are imports as well, so files that list the same namespaces are not duplicated code.
+const USING_LINE = /^\s*(global\s+)?using\s+(static\s+)?[\w.]+(\s*=\s*[\w.<>, ]+)?\s*;\s*$/;
 const MIN_DISTINCT_LINES = 4;
 
 function normalizeLines(file) {
   return file.lines.map((line) => {
-    if (COMMENT_LINE.test(line) || IMPORT_LINE.test(line)) return "";
+    if (COMMENT_LINE.test(line) || IMPORT_LINE.test(line) || USING_LINE.test(line)) return "";
     return line.trim().replace(/\s+/g, " ");
   });
 }
