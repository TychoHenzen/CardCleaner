+// Godot registers [GlobalClass] types by name, and [Service] classes are built by the
+// service container through reflection, so no static reference reaches either one.
+const EXEMPT_CLASS_ATTRIBUTE =
+  /(?:^|[\s,])(?:Godot\.)?(?:GlobalClass|Service)(?:Attribute)?(?=\s*(?:\(|,|$))/;
+function hasExemptClassAttribute(code, classStart) {
+  let cursor = classStart;
+  while (cursor > 0 && /\s/.test(code[cursor - 1])) cursor -= 1;
+  while (cursor > 0 && code[cursor - 1] === "]") {
+    const open = code.lastIndexOf("[", cursor - 1);
+    if (open < 0) return false;
+    if (EXEMPT_CLASS_ATTRIBUTE.test(code.slice(open + 1, cursor - 1)))
+      return true;
+    cursor = open;
+    while (cursor > 0 && /\s/.test(code[cursor - 1])) cursor -= 1;
+  }
+  return false;
+}
 function directExports(file, scan) {
   const found = new Map();
   for (const pattern of EXPORT_PATTERNS[file.lang] ?? []) {
     for (const match of matchesFor(pattern, scan.code)) {
+      if (
+        file.lang === "cs" &&
+        hasExemptClassAttribute(scan.code, match.index)
+      )
+        continue;
       const offset = match.index + match[0].lastIndexOf(match[1]);
       found.set(match[1], { line: lineAt(scan.starts, match.index), offset });
     }
