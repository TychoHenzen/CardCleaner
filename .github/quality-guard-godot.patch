diff --git a/packages/quality-guard/skills/quality-refactor/scripts/lib/rules-reachability.mjs b/packages/quality-guard/skills/quality-refactor/scripts/lib/rules-reachability.mjs
--- a/packages/quality-guard/skills/quality-refactor/scripts/lib/rules-reachability.mjs
+++ b/packages/quality-guard/skills/quality-refactor/scripts/lib/rules-reachability.mjs
@@ -23,20 +23,40 @@
 function matchesFor(pattern, code) {
   const matches = [];
   pattern.lastIndex = 0;
   let match = pattern.exec(code);
   while (match !== null) {
     matches.push(match);
     match = pattern.exec(code);
   }
   return matches;
 }
+const GODOT_GLOBAL_CLASS_ATTRIBUTE =
+  /(?:^|[\s,])(?:Godot\.)?GlobalClass(?:Attribute)?(?=\s*(?:\(|,|$))/;
+function hasGodotGlobalClassAttribute(code, classStart) {
+  let cursor = classStart;
+  while (cursor > 0 && /\s/.test(code[cursor - 1])) cursor -= 1;
+  while (cursor > 0 && code[cursor - 1] === "]") {
+    const open = code.lastIndexOf("[", cursor - 1);
+    if (open < 0) return false;
+    if (GODOT_GLOBAL_CLASS_ATTRIBUTE.test(code.slice(open + 1, cursor - 1)))
+      return true;
+    cursor = open;
+    while (cursor > 0 && /\s/.test(code[cursor - 1])) cursor -= 1;
+  }
+  return false;
+}
 function directExports(file, scan) {
   const found = new Map();
   for (const pattern of EXPORT_PATTERNS[file.lang] ?? []) {
     for (const match of matchesFor(pattern, scan.code)) {
+      if (
+        file.lang === "cs" &&
+        hasGodotGlobalClassAttribute(scan.code, match.index)
+      )
+        continue;
       const offset = match.index + match[0].lastIndexOf(match[1]);
       found.set(match[1], { line: lineAt(scan.starts, match.index), offset });
     }
   }
   return found;
 }
